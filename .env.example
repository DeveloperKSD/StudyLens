# Copy this file to ".env" (same folder as app.py) and fill in ONLY the providers you use.
#   macOS/Linux:  cp .env.example .env
#   Windows:      copy .env.example .env
# Never commit .env to Git (it is already listed in .gitignore). Restart Streamlit after editing.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=

# Optional: which cloud provider is preselected in the sidebar (openai, anthropic, gemini, groq, ...)
# DEFAULT_PROVIDER=anthropic

# Optional: override the model dropdown for any provider (comma-separated)
# OPENAI_MODELS=gpt-4o-mini,gpt-4.1
# ANTHROPIC_MODELS=claude-haiku-5-5,claude-sonnet-5-5
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro

# Optional: custom OpenAI-compatible server (LM Studio, vLLM, llama.cpp server, Azure proxy...)
# CUSTOM_BASE_URL=http://127.0.0.1:1234/v1
# CUSTOM_API_KEY=
# CUSTOM_MODELS=my-local-model

# Optional: Ollama on another machine/port
# OLLAMA_HOST=http://127.0.0.1:11434
